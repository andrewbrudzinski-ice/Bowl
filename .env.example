# Copy to .env.local and fill in. Never commit real values.

# Required in production: 32+ random chars used to sign session cookies.
#   openssl rand -base64 48
SESSION_SECRET=

# Public base URL (used in invitation / password-reset links and share links).
APP_URL=http://localhost:3000

# File store location (used only when no database is configured). Single instance only. See docs/DEPLOYMENT.md.
BOWL_DATA_FILE=./data/db.json

# --- Optional: email (password reset, invitations). Not required for core use. ---
# When unset, links are written to the server log instead of emailed.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM="League <noreply@example.com>"

# --- Storage backend (pick one; see docs/SUPABASE.md) ---
# 1) PostgreSQL / Supabase. Run `npm run db:migrate` before first start.
# DATABASE_URL=postgresql://user:password@host:6543/postgres
# DATABASE_SSL=no-verify        # "require" or "no-verify"; Supabase poolers usually need no-verify with node-postgres
# DATABASE_POOL_MAX=5
# BOWL_AUTO_MIGRATE=0           # keep off in production; run db:migrate as a release step
# 2) Embedded Postgres (PGlite) for local work — real Postgres semantics, single process:
# BOWL_PGLITE_DIR=./data/pglite
# 3) Neither set: the file store at BOWL_DATA_FILE (single instance only).

# Never expose database credentials or a Supabase service-role key to the browser (no NEXT_PUBLIC_ prefix).
