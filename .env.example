# Copy to .env.local and fill in. Never commit real values.

# Required in production: 32+ random chars used to sign session cookies.
#   openssl rand -base64 48
SESSION_SECRET=

# Public base URL (used in invitation / password-reset links and share links).
APP_URL=http://localhost:3000

# Where the local file-backed store keeps its data (default ./data/db.json).
# NOTE: file storage is for single-instance / local use. See docs/DEPLOYMENT.md.
BOWL_DATA_FILE=./data/db.json

# --- Optional: email (password reset, invitations). Not required for core use. ---
# When unset, links are written to the server log instead of emailed.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM="League <noreply@example.com>"

# --- Supabase (schema + RLS migrations are in supabase/migrations). ---
# The app does NOT yet read from Supabase; see docs/SUPABASE.md.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # server only, never expose to the browser
